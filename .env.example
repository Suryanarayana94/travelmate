# ─────────────────────────────────────────────────────────────────────────────
# TravelMate backend configuration
# Copy this file to .env (cp .env.example .env) and fill in your own values.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers → copy the mongodb+srv:// string.
# Replace <username>, <password> and the cluster host. URL-encode special
# characters in the password (for example @ → %40).
# This is the ONLY database TravelMate uses: there is no Docker service, no
# local mongod and no in-memory fallback. Until this is set, the API answers 503
# on data routes and the web app shows a "Connect MongoDB Atlas" setup screen.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/travelmate?retryWrites=true&w=majority&appName=TravelMate

# Optional: override the database name if the URI does not include one.
# MONGODB_DB=travelmate

# Optional driver tuning (ms). Defaults: 20000 for Atlas, 10000 otherwise.
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=20000
# MONGODB_CONNECT_TIMEOUT_MS=20000
# MONGODB_MAX_POOL_SIZE=10

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API.
CLIENT_URL=http://localhost:5173

# ── Seed data ────────────────────────────────────────────────────────────────
# true → destinations + four demo accounts/services/bookings are upserted on
# every boot (idempotent). Set to false for a clean production database.
SEED_DEMO_DATA=true

# Set to false to only accept the curated boarding cities (no Nominatim calls).
ENABLE_GEOCODING=true

# ── Frontend (optional) ──────────────────────────────────────────────────────
# The Vite dev server proxies /api to the backend, so this can stay as-is.
VITE_API_URL=/api
